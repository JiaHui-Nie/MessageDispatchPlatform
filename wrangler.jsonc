{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare 通过 GitHub 连接创建的项目会使用仓库名的小写形式作为 Worker 名称
  //（MessageDispatchPlatform → messagedispatchplatform）。
  // 两者不一致时 Workers Builds 会提示名称不匹配并覆盖本次构建，因此这里保持同名。
  "name": "messagedispatchplatform",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "message-dispatch-platform",
      // 不填 database_id 时，`wrangler deploy` 会自动创建并绑定 D1 数据库
      //（Deploy to Cloudflare 一键部署依赖这一行为）。
      // 如需使用已有数据库：`wrangler d1 create message-dispatch-platform`
      // 然后把返回的 UUID 填到下面的 database_id。
      // "database_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
      "migrations_dir": "migrations"
    }
  ],
  // 可选：启用 R2 文件存储后取消下面注释，并先创建同名存储桶：
  //   pnpm exec wrangler r2 bucket create message-dispatch-platform-files
  // 未绑定时平台自动使用 D1 分块存储，不影响使用。
  // "r2_buckets": [
  //   { "binding": "FILES", "bucket_name": "message-dispatch-platform-files" }
  // ],
  "vars": {
    "APP_NAME": "信息分发平台",
    "DISPLAY_TZ": "Asia/Shanghai",
    "SESSION_TTL_HOURS": "168",
    "PASSWORD_ITERATIONS": "100000",
    "DEFAULT_STORAGE_QUOTA_MB": "50",
    // 超过该大小（MB）的文件使用 R2 预签名直传；0 表示全部直传。
    "DIRECT_UPLOAD_THRESHOLD_MB": "20",
    // 文件存储默认后端：auto（有 R2 绑定则用 R2，否则 D1）/ d1 / r2。
    // 管理后台的「文件存储后端」设置优先于这里的默认值。
    "FILE_STORAGE": "auto"
  }
}
