{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "message-dispatch-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "message-dispatch-platform",
      // 不填 database_id 时，`wrangler deploy` 会自动创建并绑定 D1 数据库
      //（Deploy to Cloudflare 一键部署依赖这一行为）。
      // 如需使用已有数据库：`wrangler d1 create message-dispatch-platform`
      // 然后把返回的 UUID 填到下面的 database_id。
      // "database_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "信息分发平台",
    "DISPLAY_TZ": "Asia/Shanghai",
    "SESSION_TTL_HOURS": "168",
    "PASSWORD_ITERATIONS": "100000"
  }
}
